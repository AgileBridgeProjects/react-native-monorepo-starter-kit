{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "typecheck": {},
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "check": {
      "dependsOn": ["lint", "typecheck", "test"]
    },
    "generate:proxy": {
      "cache": false
    },
    "generate:proxy:local": {
      "inputs": [
        "openapi/**",
        "orval.config.ts",
        "src/lib/http/orval-mutator.ts",
        "scripts/fetch-openapi.mjs"
      ],
      "outputs": ["src/proxy/**"]
    }
  }
}
