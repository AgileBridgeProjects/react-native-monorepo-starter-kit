{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/guard-write.mjs" }]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/guard-bash.mjs" },
          { "type": "command", "command": "node .claude/hooks/pr-readiness-nudge.mjs" },
          { "type": "command", "command": "node .claude/hooks/pr-prose-guard.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/lint-on-edit.mjs", "timeout": 90 }
        ]
      }
    ]
  }
}
