{
  "name": "starterkit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev:expo": "npm run dev -w apps/expo",
    "dev:web": "npm run dev -w apps/web",
    "dev:backend": "docker compose --env-file infra/supabase/.env up",
    "dev:stack": "docker compose --env-file infra/supabase/.env --profile web up",
    "rebuild:backend": "docker compose --env-file infra/supabase/.env build && docker compose --env-file infra/supabase/.env up -d --wait",
    "build:web": "npm run build -w apps/web",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "biome check . && npm run typecheck && npm run test && npm run check:locale-casing && npm run check:architecture && npm run check:standards",
    "generate:proxy": "npm run generate:proxy --workspaces --if-present",
    "generate:proxy:local": "npm run generate:proxy:local --workspaces --if-present",
    "spec:dashboard": "npx -y @pimzino/spec-workflow-mcp@2.2.5 --dashboard",
    "e2e": "bash e2e/scripts/run-e2e.sh",
    "e2e:affected": "node e2e/scripts/e2e-affected.mjs",
    "e2e:playwright": "bash e2e/scripts/run-e2e.sh playwright",
    "e2e:maestro": "bash e2e/scripts/run-e2e.sh maestro",
    "e2e:down": "docker compose -f e2e/docker-compose.e2e.yml -p starterkit-e2e down -v --remove-orphans",
    "check:e2e-attestation": "node scripts/check-e2e-attestation.mjs",
    "check:e2e-receipt": "node scripts/check-e2e-receipt.mjs",
    "check:locale-casing": "node scripts/check-locale-casing.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:standards": "node scripts/check-standards.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:all": "node scripts/check-secrets.mjs --all",
    "check:markdown": "markdownlint-cli2 \"**/*.md\"",
    "scaffold:backend": "node tools/scaffold-backend-feature.mjs",
    "scaffold:frontend": "node tools/scaffold-frontend-feature.mjs",
    "build:domain-explorer": "node scripts/build-domain-explorer.mjs",
    "postinstall": "patch-package",
    "prepare": "husky",
    "knip": "knip"
  },
  "overrides": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "husky": "^9.1.7",
    "knip": "^6.25.0",
    "lint-staged": "^15.5.0",
    "markdownlint-cli2": "^0.23.0",
    "patch-package": "^8.0.1",
    "secretlint": "^13.0.2",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3"
  }
}
