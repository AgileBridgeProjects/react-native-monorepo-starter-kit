# ─────────────────────────────────────────────────────────────
# E2E Test Credentials — this file is OPTIONAL.
#
# Local dev needs NO configuration at all: the harness falls back to the dev
# admin the migrator seeds into the self-hosted Supabase (GoTrue) stack
# (admin@starterkit.local — see SupabaseAuthSeeder). Start the stack with
# `npm run dev:backend` and run the suite.
#
# Overrides are stored in Azure Key Vault (kv-starterkit-dev, tag: app=e2e)
# and fetched automatically at runtime:
#
#   • npm run e2e         — run-e2e.sh fetches from KV via your `az login` session
#   • CI pipeline         — fetches from KV via OIDC (no secrets stored in GitHub)
#   • npx playwright test — run `cd e2e && npm run pull:env` first to write this file
#
# You only need this file if you run `npx playwright test` directly and want to
# override a value without `az` access.
#
# To regenerate: cd e2e && npm run pull:env  (requires `az login`)
# ─────────────────────────────────────────────────────────────

# KV secret: e2e-admin-email (defaults to the seeded dev admin)
# E2E_ADMIN_EMAIL=admin@starterkit.local

# KV secret: e2e-admin-password (defaults to the seeded dev password)
# E2E_ADMIN_PASSWORD=

# Seeded Athlete account used by e2e/maestro/onboarding/ — must have
# completed account setup (password already set) so the flow can log in directly.
# KV secret: e2e-athlete-email
# E2E_ATHLETE_EMAIL=

# KV secret: e2e-athlete-password
# E2E_ATHLETE_PASSWORD=

# Seeded completed Athlete used by the identity split summary flows. Must have a
# context-bearing latest check-in, Happy data in 7 days, and older data in 30 days.
# KV secret: e2e-emotion-athlete-email
# E2E_EMOTION_ATHLETE_EMAIL=

# KV secret: e2e-emotion-athlete-password
# E2E_EMOTION_ATHLETE_PASSWORD=

# Seeded completed Athlete with no check-ins, used for the the identity split zero state.
# KV secret: e2e-empty-athlete-email
# E2E_EMPTY_ATHLETE_EMAIL=

# KV secret: e2e-empty-athlete-password
# E2E_EMPTY_ATHLETE_PASSWORD=

# Seeded Director account used by e2e/maestro/onboarding/ — must have
# completed account setup (password already set) so the flow can log in directly.
# KV secret: e2e-director-email
# E2E_DIRECTOR_EMAIL=

# KV secret: e2e-director-password
# E2E_DIRECTOR_PASSWORD=

# Seeded Parent account used by e2e/maestro/onboarding/ — must have
# completed account setup (password already set) AND have at least one linked
# athlete, which the flow's relationship step depends on. Also used by
# e2e/maestro/check-ins/permission-gate-parent.yaml — Parent does not
# hold StarterKit.CheckIns.Access by default, so this same account proves the
# check-in flow is hidden rather than shown for a role without the permission.
# KV secret: e2e-parent-email
# E2E_PARENT_EMAIL=

# KV secret: e2e-parent-password
# E2E_PARENT_PASSWORD=

# Seeded Coach account used by e2e/maestro/onboarding/ — must have
# completed account setup (password already set) AND be linked to at least one
# team, which the flow's linked-teams step depends on.
# KV secret: e2e-coach-email
# E2E_COACH_EMAIL=

# KV secret: e2e-coach-password
# E2E_COACH_PASSWORD=

# Supabase/GoTrue overrides — default to the local self-hosted stack + the
# committed demo JWT secret (infra/supabase/.env.example). Only set when
# targeting a non-local Supabase.
# SUPABASE_URL=http://localhost:8000
# SUPABASE_JWT_SECRET=

# Not a secret — defaults to http://localhost:3000 in playwright.config.ts
# PLAYWRIGHT_BASE_URL=http://localhost:3000
