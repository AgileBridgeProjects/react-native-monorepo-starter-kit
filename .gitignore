# ── EF Core Migrations (keep migrations, ignore snapshots cache) ──
# Do NOT ignore Migrations folder - we want these in source control

# ── App Secrets / Config ─────────────────────────────────────
appsettings.Development.json
appsettings.Local.json
secrets.json
*.pfx
*.p12

# ── Node / NPM ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
lerna-debug.log*

# ── React / Next.js / Vite ───────────────────────────────────
.next/
out/
dist/
dist-ssr/
*.tsbuildinfo
*.local
.cache/
.parcel-cache/

# ── Expo / React Native ──────────────────────────────────────
.expo/
.expo-shared/
*.jks
*.p8
*.mobileprovision
*.orig.*
web-build/
ios/
android/

# Local Expo native modules ship their own android/ source — it must be tracked.
# (The bare `android/` rule above otherwise excludes it, omitting the native module
# from git even though EAS picks it up via .easignore.)
!apps/expo/modules/*/android/
!apps/expo/modules/*/android/**

# ── Environment files ────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml

# ── Azure ────────────────────────────────────────────────────
.azure/
local.settings.json

# ── Azurite (local Azure Storage emulator) ───────────────────
__azurite_db_blob__.json
__azurite_db_blob_extent__.json
__azurite_db_queue__.json
__azurite_db_queue_extent__.json
__azurite_db_table__.json
__azurite_db_table_extent__.json
__blobstorage__/
__queuestorage__/
__tablestorage__/
AzuriteConfig

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editors ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/mcp.json
.idea/
*.swp
*.swo
*~

# ── Test results ─────────────────────────────────────────────
TestResults/
coverage/
*.trx
*.coveragexml
lcov.info

# ── Spec Workflow MCP (approval state is local, specs are tracked) ─
.spec-workflow/approvals/
.spec-workflow/archive/

# ── BMAD output (scratch artifacts) ─────────────────────────
_bmad-output/*.patch

# ── Claude Code (local settings are personal, not shared) ────
.claude/settings.local.json
.claude/worktrees/

# ── .NET first-use sentinel / home dir (CI-generated artefacts) ──
dotnet-home/

# ── Playwright MCP screenshots / snapshots (local dev artifacts) ──
.playwright-mcp/

# ── E2E test artifacts (generated, not tracked) ──────────────
e2e/node_modules/
e2e/test-results/
e2e/html-report/
# Local run receipt written by `npm run e2e:affected` (see docs/standards/e2e-testing.md)
e2e/.e2e-receipt.json
# Playwright storageState auth files (contain session tokens, never commit)
e2e/.auth/
# Local E2E credentials — copy from .env.e2e.example and fill in values
e2e/.env.e2e
# Playwright saved auth state — contains credentials, never commit
e2e/.auth/

apps/backend/nul

# Static Expo web export built by e2e:affected (mirrors the CI job) — never committed.
e2e/.expo-web-dist/

# ── BMAD planning artifacts (working docs, not meant to be committed) ──
_bmad-output/planning-artifacts/*
!_bmad-output/planning-artifacts/.gitkeep

# E2E harness caches — resolved secrets and the static-export digest sidecar.
e2e/.env.e2e.kvcache
e2e/.expo-web-dist.key
e2e/blob-report/

# Credential material the docs tell you to create. Never commit any of it.
apps/expo/keys/
*.keystore
*.pem
.env.*
!.env.example
!.env.*.example
