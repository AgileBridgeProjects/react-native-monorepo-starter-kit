# ─────────────────────────────────────────────────────────────────────────────
# StarterKit self-hosted Supabase (DB + Auth) — environment.
#
#   cp infra/supabase/.env.example infra/supabase/.env
#
# The values below are Supabase's PUBLIC DEMO secrets. They boot the local stack
# working out of the box (ANON_KEY / SERVICE_ROLE_KEY are JWTs signed with the
# demo JWT_SECRET). They are published in Supabase's docs and are therefore NOT
# secret — REGENERATE EVERYTHING before deploying anywhere shared or public.
#
# To regenerate (see infra/supabase/README.md):
#   JWT_SECRET       : openssl rand -base64 48   (>= 32 chars)
#   POSTGRES_PASSWORD: openssl rand -base64 24
#   ANON_KEY / SERVICE_ROLE_KEY: sign role JWTs with JWT_SECRET (script in README)
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── JWT / API keys (DEV DEMO VALUES — regenerate for anything shared) ─────────
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# ── URLs ──────────────────────────────────────────────────────────────────────
# Full external URL of the gateway. GOTRUE_JWT_ISSUER = ${API_EXTERNAL_URL}/auth/v1
# and the .NET SupabaseAuthHandler validates the issuer against it — keep them aligned.
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
# Where auth email links / redirects point (the web portal).
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# ── Auth behaviour ────────────────────────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Local dev auto-confirms sign-ups so no SMTP server is needed. Set false in prod.
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# ── Email (provider-agnostic) — OPTIONAL, leave EMAIL_ENABLED=false for silent dev mode ─
# Current provider is Resend. Get an API key at https://resend.com. onboarding@resend.dev is its shared
# testing sender — works without verifying your own domain, but is testing-only.
# Switch EMAIL_FROM_EMAIL to an address on your own domain once it's verified.
EMAIL_ENABLED=false
EMAIL_API_KEY=
EMAIL_FROM_EMAIL=onboarding@resend.dev
EMAIL_FROM_NAME=StarterKit Dev

# ── Anthropic (Claude) — journal distress-language scanning ────────
# Get an API key at https://console.anthropic.com. Leave blank to use the "#" placeholder from
# appsettings.json — the scan job will fail at call time (401), not at startup, since ApiKey
# only needs to be non-empty to pass Options validation.
ANTHROPIC_API_KEY=

# ── Journal content encryption at rest ──────────────────────────────
# AES-256 key (base64), MobileApi only. Deliberately EMPTY: a working default here is a
# key everyone who clones this repo already has, protecting the most sensitive data the
# product stores. Generate your own before first boot:
#   openssl rand -base64 32
JOURNAL_ENCRYPTION_KEY=

# ── OAuth providers (Google / Apple) ─────────────────────────────────────────
# Leave *_ENABLED=false until you have created the provider apps (see README § OAuth).
# GOOGLE_CLIENT_ID accepts a comma-separated list: the Web client id (used by GoTrue's
# redirect flow + the web portal) plus the iOS and Android client ids (whose ID tokens
# the mobile app sends via signInWithIdToken). GOOGLE_SECRET is the Web client secret.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# APPLE_CLIENT_ID: your Services ID (web) and/or app bundle id, comma-separated.
# APPLE_SECRET: the client-secret JWT generated from your Sign in with Apple .p8 key
# (valid max 6 months — must be regenerated periodically).
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_SECRET=

# Skip GoTrue nonce check so native mobile ID-token sign-in validates (safe for that flow).
SKIP_NONCE_CHECK=true

# ── Gateway ports ─────────────────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ── Optional local DB tooling (docker compose --profile tools up) ─────────────
STUDIO_PORT=54323
STUDIO_DEFAULT_ORGANIZATION=StarterKit
STUDIO_DEFAULT_PROJECT=StarterKit

# ── Backend containers: Azure Key Vault (OPTIONAL — leave blank for local dev) ─
# The backend APIs skip Key Vault entirely when AZURE_KEYVAULT_NAME is blank
# (KeyVaultOptions.IsConfigured=false) and boot from the compose command args.
# Only set a vault name to make local containers read real cloud secrets — then
# the AZURE_* service-principal values are required too, because
# DefaultAzureCredential inside a container cannot use your host `az login`:
#   az ad sp create-for-rbac --name "starterkit-local-dev" \
#     --role "Key Vault Secrets User" \
#     --scopes "$(az keyvault show --name kv-starterkit-dev --query id -o tsv)"
AZURE_KEYVAULT_NAME=
KEYVAULT_ENABLED=true
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── LAN IP (OPTIONAL) ─────────────────────────────────────────────────────────
# Used to rewrite Azurite SAS URLs so physical mobile devices can fetch blobs.
# Run `ipconfig` (Windows) / `ifconfig` (macOS/Linux) and use your LAN IPv4.
# Unset = localhost (fine for a browser on the same machine).
HOST_LAN_IP=
