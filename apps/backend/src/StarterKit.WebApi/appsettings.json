{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Mcp": {
    "Enabled": true,
    "Path": "/mcp",
    "ServerName": "starterkit-admin"
  },
  "ConnectionStrings": {
    "DefaultConnection": "#",
    "VectorConnection": "#"
  },
  "KeyVault": {
    "Name": "#"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:3001"]
  },
  "Supabase": {
    "Enabled": false,
    "ApiExternalUrl": "http://localhost:8000",
    "Audience": "authenticated"
  },
  "SqlResilience": {
    "MaxRetries": 5,
    "RetryDelayMilliseconds": 10000
  },
  "AzureStorage": {
    "AccountName": "#",
    "SasExpiryHours": 168
  },
  "Anthropic": {
    "ApiKey": "#",
    "Model": "claude-haiku-4-5",
    "MaxTokens": 8192,
    "ApiVersion": "2023-06-01"
  },
  "AzureOpenAI": {
    "ApiKey": "#",
    "Model": "gpt-4o",
    "MaxTokens": 8192,
    "ApiVersion": "2024-08-01-preview"
  },
  "AiJobs": {
    "SyncTimeoutMs": 120000,
    "PollIntervalMs": 500
  },
  "CreditCost": {
    "MarkdownCharsPerCredit": 5000
  },
  "ResourceBuilder": {
    "MaxFileSizeBytes": 10485760
  },
  "UrlSuggest": {
    "MaxTokens": 1024
  },
  "Gamification": {
    "BaseXpPerGameSession": 100,
    "MaxSpeedBonusXp": 100,
    "ExpectedSecondsPerQuestion": 30,
    "DailyActivityXpPerDay": 75,
    "RewardUnlockXp": 300,
    "SilverThreshold": 2000,
    "GoldThreshold": 8000,
    "DiamondThreshold": 20000,
    "ScoreboardBonus1st": 500,
    "ScoreboardBonus2nd": 350,
    "ScoreboardBonus3rd": 200,
    "ScoreboardBonusTop10": 100,
    "ScoreboardBonusTop50": 50
  },
  "Streaks": {
    "WeeklyRequirement": 5
  },
  "DevClock": {
    "OverrideUtc": null
  },
  "AccountSetup": {
    "PortalBaseUrl": "http://localhost:3000",
    "MobileBaseUrl": "starterkit-mobile-dev://",
    "TokenExpiryHours": 24,
    "PasswordResetExpiryHours": 1
  },
  "AuditLogRetention": {
    "RetentionDays": 90
  },
  "EligibleMatch": {
    "LookbackDays": 30
  },
  "CalendarEventRecurrence": {
    "MaxOccurrences": 366
  },
  "StatsImport": {
    "MaxFileSizeBytes": 10485760
  },
  "CreditReset": {
    "CronSchedule": "0 0 1 * *"
  },
  "Email": {
    "Enabled": false,
    "ApiKey": "",
    "FromEmail": "dev@example.com",
    "FromName": "StarterKit"
  },
  "Twilio": {
    "UseTestCredentials": false
  },
  "ImageUpload": {
    "AllowedContentTypes": ["image/jpeg", "image/png", "image/gif", "image/webp"],
    "MaxFileSizeBytes": 20971520
  },
  "LogoUpload": {
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "image/webp",
      "image/gif",
      "image/bmp",
      "image/svg+xml"
    ],
    "MaxFileSizeBytes": 10485760
  },
  "VideoTranscode": {
    "FfmpegBinaryFolder": "/usr/bin",
    "Crf": 22,
    "Preset": "veryfast",
    "Threads": 1
  },
  "Session": {
    "IdleTimeoutMinutes": 30,
    "AbsoluteTimeoutHours": 8,
    "WarningMinutes": 5
  },
  "Cache": {
    "UserPreferencesTtlSeconds": 300
  },
  "DiscAssessment": {
    "SessionTtlSeconds": 3600
  }
}
