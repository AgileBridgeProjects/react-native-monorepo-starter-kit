# MobileApi base URL
# Auto-set by `npm run pull:env` to http://<your-LAN-IP>:5001 for physical device testing.
# Override manually if your backend runs on a different port or machine.
# Deployed envs: managed via Azure Key Vault (tag app=expo env=<env>), not this file.

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
EXPO_PUBLIC_MICROSOFT_TENANT_ID=

# Local self-hosted Supabase (GoTrue via the Kong gateway on :8000).
# `npm run pull:env` auto-fills EXPO_PUBLIC_SUPABASE_URL with this machine's LAN IP
# (http://<lan-ip>:8000) so a physical dev client / emulator on the same WiFi can
# sign in against local Supabase docker. Android emulator: set 10.0.2.2 instead.
# The anon key falls back to the committed local demo key in config.ts.
# Deployed builds get the hosted project's values from Key Vault (tag app=expo env=<env>).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_FORCE_OFFLINE=
# Dev-only: skip auth and boot straight into the tabs (see .env.development)
EXPO_PUBLIC_BYPASS_AUTH=true

# Social sign-in (Google / Apple) on the login screen.
# Absent / anything other than 'true' = OFF (default): auth ships email/password only.
# Set to 'true' ONLY after enabling + configuring the matching GoTrue providers
# (GOOGLE_ENABLED / APPLE_ENABLED in infra/supabase/.env) — otherwise the buttons will error on press.
EXPO_PUBLIC_SOCIAL_AUTH_ENABLED=
