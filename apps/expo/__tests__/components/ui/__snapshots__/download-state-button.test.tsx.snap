  accessibilityRole="button"
  className="items-center justify-center"
  onPress={[Function]}
  testID="remove-btn"
>
  <View
    testID="icon-checkmark.circle.fill"
  />
</Pressable>
`;

exports[`DownloadStateButton > matches the downloading snapshot 1`] = `
