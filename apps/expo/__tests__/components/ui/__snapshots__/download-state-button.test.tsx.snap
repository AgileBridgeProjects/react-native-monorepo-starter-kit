  className="items-center justify-center rounded-xl px-md py-md bg-white"
>
  <Pressable
    onPress={[Function]}
    testID="progress-button"
  />
</View>
`;

exports[`DownloadStateButton > matches the not-downloaded snapshot 1`] = `
