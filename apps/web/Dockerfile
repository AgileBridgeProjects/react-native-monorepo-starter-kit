FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci

COPY . .

# apps/web/.env.local is generated by CI from Key Vault (tagged app=web)
# before docker build runs. Next.js gives .env.local highest precedence in all
# build modes. No ARG/ENV declarations needed here — adding a secret to Key
# Vault is enough.
RUN npm run build -w apps/web

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web ./apps/web
COPY --from=build /app/packages/shared ./packages/shared
COPY --from=build /app/tsconfig.base.json ./tsconfig.base.json

EXPOSE 3000
CMD ["npm", "run", "start", "-w", "apps/web"]
