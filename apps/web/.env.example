# Admin Portal → WebApi base URL
# Defaults to http://localhost:5002 — only set this to override (e.g. a different local port or a remote env).
# LAN dev: set to http://<HOST_LAN_IP>:5002 (matching HOST_LAN_IP in infra/supabase/.env) so links
# opened on a phone (e.g. the setup-account email link) can reach the API — localhost on a phone
# means the phone itself, not this machine. Also add that origin to webapi's CORS allowlist
# (apps/backend/docker-compose.yml, --Cors:AllowedOrigins).
# Deployed envs: managed via Azure Key Vault (tag app=web env=<env>), not this file.
NEXT_PUBLIC_API_URL=

# Supabase (self-hosted GoTrue) auth
# URL defaults to the local Kong gateway (http://localhost:8000); the anon key
# defaults to the local self-hosted demo key. Set both only when targeting a
# non-dev Supabase project (staging/production) — the anon key is a public JWT,
# not a secret. Deployed envs: managed via Azure Key Vault (tag app=web env=<env>).
# LAN dev: URL should also become http://<HOST_LAN_IP>:8000, same reasoning as NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DevExtreme license key — the only real secret this app needs.
# Stored in Azure Key Vault (secret `next-public-devextreme-license-key`, tags app=web env=dev local=true).
# Run `npm run pull:env` to populate .env.local from Key Vault.
NEXT_PUBLIC_DEVEXTREME_LICENSE_KEY=

# Social sign-in (Google / Apple / Microsoft) on the login screen.
# Absent / anything other than 'true' = OFF (default): auth ships email/password only.
# Set to 'true' ONLY after enabling + configuring the matching GoTrue providers
# (GOOGLE_ENABLED / APPLE_ENABLED in infra/supabase/.env) — otherwise the buttons will error on click.
NEXT_PUBLIC_SOCIAL_AUTH_ENABLED=

# Native deep-link scheme for the "Open in app" button on the mobile setup-account web
# fallback. Must match the build profile distributed for this environment:
# dev = starterkit-mobile-dev, uat = starterkit-mobile-uat, production = starterkit-mobile.
# Defaults to starterkit-mobile-dev when unset.
NEXT_PUBLIC_MOBILE_APP_SCHEME=

# Store links shown by the mobile setup-account web fallback when the
# native app isn't installed. Public URLs, not secrets. Leave blank pre-launch
# (no Play Store listing yet; Android ships via direct APK/TestFlight-equivalent
# download) — that store's button just stays hidden.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
