{
  "name": "@starterkit/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && vitest run",
    "generate:proxy": "node scripts/fetch-openapi.mjs && orval && biome check --fix src/proxy/",
    "generate:proxy:local": "orval && biome check --fix src/proxy/",
    "pull:env": "node scripts/pull-env.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/signalr": "^10.0.0",
    "@starterkit/icons": "^0.0.0",
    "@starterkit/shared": "*",
    "@supabase/supabase-js": "2.110.0",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "country-flag-icons": "^1.6.19",
    "devextreme": "^24.2",
    "devextreme-react": "^24.2",
    "i18next": "^26.0.3",
    "libphonenumber-js": "^1.13.7",
    "next": "^16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.57.0",
    "react-i18next": "^17.0.2",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^28.1.0",
    "msw": "^2.10.2",
    "orval": "^8.30.0",
    "tailwindcss": "^4",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
