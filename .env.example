# ── Local Tool Credentials ────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — your secrets stay local.
#
# Local scripts and agent workflows read these env vars when they need
# authenticated services.
# See docs/ai-tooling-setup.md for where to generate each key.
#
# Note: Linear uses OAuth (browser-based) — no API key needed.
# ──────────────────────────────────────────────────────────────

# PostgreSQL — connection details for the psql CLI tool
# These are the standard libpq env vars — no flags needed when they are set.
# Install psql (PostgreSQL client): https://www.postgresql.org/download/
# See docs/mcp-postgres.md for full setup instructions.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=starterkit
# For Azure Database for PostgreSQL, also set: PGSSLMODE=require
